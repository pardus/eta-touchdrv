PACKAGE_VERSION="__VERSION__"
PACKAGE_NAME="eta-touchdrv"

if grep -qi "clang" /proc/version 2>/dev/null; then
    MAKE="make CC=clang LLVM=1 LLVM_IAS=1 KVER=${kernelver}"
else
    MAKE="make CC=gcc KVER=${kernelver}"
fi
BUILT_MODULE_NAME[0]="OpticalDrv"
BUILT_MODULE_LOCATION[0]=""
DEST_MODULE_LOCATION[0]="/extra"
AUTOINSTALL="yes"
